export SESSION_EXPIRE_AT_BROWSER_CLOSE=False
export IS_PRODUCTION=False
export DJANGO_SECRET_KEY="4toiijiojijo9ijo@@£w"
export IS_DOCKER=False
export DEBUG=True
# Set MEDIA_ROOT relative to the folder containing this .dev.env file.
# This uses zsh's `${(%):-%x}` expansion to get the current file path when
# the file is sourced in zsh. If you source this file from another shell,
# you may need to adjust the logic accordingly.
DEV_ENV_DIR="$(cd "$(dirname "${(%):-%x}")" >/dev/null 2>&1 && pwd)"
export MEDIA_ROOT="$DEV_ENV_DIR/app/media"

# Abilita l'espansione dei comandi nel prompt
setopt PROMPT_SUBST

# Funzione ottimizzata
venv_name() {
  [[ -n "$VIRTUAL_ENV" ]] && echo -n "($(basename "$VIRTUAL_ENV"))"
}

# Prompt
PROMPT='%F{green} $(venv_name) DEV ENVs > %F{black}'

alias p="python3.9 manage.py"

echo "REMEMBER"
echo "p=\"python3.9 manage.py\""
echo 