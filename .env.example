# Optional settings for SPARC. Copy this file to ".env" and change what you need;
# without a .env file the defaults below are used.

# Address of the website: http://localhost:3000
SPARC_PORT=3000
# 127.0.0.1 = only this computer can open SPARC. 0.0.0.0 = every computer of the network
# (change the admin password before doing this).
SPARC_HOST=127.0.0.1

# Login created on the very first start (change the password afterwards in the admin pages)
SPARC_ADMIN_USER=admin
SPARC_ADMIN_PASSWORD=sparc

# Set to True only when SPARC is served over HTTPS
USE_HTTPS=False
