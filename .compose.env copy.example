# Database Configuration
export DB_ROOT_PASSWORD=your_root_password_here
export DB_NAME=concast_db
export DB_USER=concast_user
export DB_PASSWORD=your_secure_password_here


export SESSION_EXPIRE_AT_BROWSER_CLOSE=False
export IS_PRODUCTION=False
export DJANGO_SECRET_KEY="write here the key"
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# Create the first admin account (needed to log in to the web app) with:
#   docker compose exec -e DJANGO_SUPERUSER_PASSWORD='<password>' backend python manage.py initadmin
# Set to True when the app is served over HTTPS
export USE_HTTPS=False
export IS_DOCKER=False
export DEBUG=True
export DEV_ENV_DIR="$(cd "$(dirname "${(%):-%x}")" >/dev/null 2>&1 && pwd)"
export MEDIA_ROOT="$DEV_ENV_DIR/app/media"

# Django Configuration
ALLOWED_HOSTS="localhost 192.168.1.1"
CSRF_TRUSTED_ORIGINS="http://localhost:8000 http://localhost:3000"

PROMPT='%F{red} $(venv_name) DOCKER ENVs > %F{black}'



